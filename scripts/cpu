#!/bin/bash

THRESHOLD=95

# 1. Get the current temperature via the shared reader
TEMP=$(/home/elyes/projects/pc-overwatch/scripts/read_temp)

echo "$(date '+%H:%M:%S') Current CPU temp: ${TEMP}°C"

# 2. If it exceeds the threshold, trigger the Telegram alert
if [ "$TEMP" -gt "$THRESHOLD" ]; then
    /home/elyes/projects/pc-overwatch/.venv/bin/python3 \
        /home/elyes/projects/pc-overwatch/scripts/send_alert.py "$TEMP"
fi