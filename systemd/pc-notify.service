[Unit]
Description=PC Boot/Shutdown Telegram Notification
After=network-online.target
Wants=network-online.target
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/projects/pc-overwatch
ExecStartPre=/bin/sleep 10
ExecStart=%h/projects/pc-overwatch/.venv/bin/python3 %h/projects/pc-overwatch/scripts/pc_notify.py boot
ExecStop=%h/projects/pc-overwatch/.venv/bin/python3 %h/projects/pc-overwatch/scripts/pc_notify.py shutdown
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=default.target
